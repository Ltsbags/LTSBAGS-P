# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SITE_URL / APP_URL: Configurable website domain (e.g., https://ltsbags.com)
SITE_URL="https://ltsbags.com"
APP_URL="https://ltsbags.com"

# INDEXING_ENABLED: Set to "true" for production indexing, or "false" during testing/staging to output noindex
INDEXING_ENABLED="true"

# DATABASE_URL: Optional PostgreSQL connection string for external production database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ltsbags?schema=public"

# ADMIN_EMAIL & PASSWORD: Initial admin credentials for login
ADMIN_EMAIL="admin@ltsbags.com"
ADMIN_PASSWORD="admin_secure_password_123"

# JWT_SECRET: Secret key for signing admin authentication tokens
JWT_SECRET="lts_bags_super_secret_jwt_key_2026"

# METRICOOL_TRACKER_HASH: Unique tracking hash from Metricool Dashboard (Brand Settings -> Web / Blog -> JavaScript Tracking Code)
# Leave blank or set your actual Metricool tracking hash
NEXT_PUBLIC_METRICOOL_TRACKER_HASH=

# MAINTENANCE_MODE: Set to "true" to display maintenance page to public visitors, or "false" (default) for live website
MAINTENANCE_MODE="false"

# PRODUCT IMAGE PROCESSING (OPTIONAL)
# Image background removal and upscaling run on built-in Sharp processing by default without requiring external keys.
# External providers (Remove.bg, ClipDrop, Replicate) are completely optional and can be configured in Admin Settings.


